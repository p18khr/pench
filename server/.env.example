# Copy this to .env and fill with real values — do NOT commit .env to git

# Gmail OAuth2 (preferred — works on Render/Vercel without SMTP port issues)
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_USER=your-sending-email@gmail.com

# SMTP fallback (used only if Gmail OAuth2 vars are not set)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Server port (Render sets this automatically)
# PORT=10000
